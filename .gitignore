# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
playwright-report/
test-results/

# next.js
.next/
out/

# CI checkout of rgctl/rgctl for docs + language coverage
.rgctl-src/

# copied from docs/videos at build/dev time
public/demos/

# VHS working tree (CoolStore / fixture symlinks)
docs/videos/.work/

# Raw VHS outputs — commit captioned guides/<slug>.mp4 only
docs/videos/guides/*-no-captions.*
docs/videos/guides/*.gif

# copied from docs/ at build/dev time
content/docs/

# generated from crates/rgctl-lang-*/ *-ast-coverage.json
content/languages/

# production
build/
dist/

# misc
.DS_Store
*.pem
*.tsbuildinfo
.eslintcache
.turbo/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env (never commit secrets; use .env.example if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript (regenerated by next)
next-env.d.ts
